# ── Database ──
DATABASE_URL="postgresql://sadebot:PASSWORD@localhost:5432/sadebot?schema=public"

# ── Discord Bot & OAuth ──
# Bot 탭에서 발급 (Discord Developer Portal)
DISCORD_BOT_TOKEN=
# General Information 탭의 Application ID
DISCORD_CLIENT_ID=
# OAuth2 탭의 Client Secret (웹 패널 로그인에 필요)
DISCORD_CLIENT_SECRET=
# 슬래시 명령어를 즉시 반영할 서버 ID (비워두면 전역 등록, 최대 1시간 소요)
DISCORD_GUILD_ID=
DISCORD_LOG_CHANNEL_ID=
DISCORD_REPORT_CHANNEL_ID=
DISCORD_LOG_WEBHOOK_URL=
# 최초 Owner로 지정할 본인 Discord 사용자 ID
OWNER_DISCORD_ID=

# ── Web ──
NEXT_PUBLIC_BASE_URL=https://your-domain.example
SESSION_SECRET=replace_with_random_hex

PORT=3016
