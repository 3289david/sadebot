generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// 열거형은 Postgres enum으로 관리 (Prisma가 이관/검증 지원)
// ─────────────────────────────────────────────────────────────

enum CaseStatus {
  RECEIVED // 접수
  REVIEWING // 검토중
  NEEDS_MORE_INFO // 추가자료 요청
  VERIFIED // 검증완료
  DISPUTED // 이의제기
  ON_HOLD // 보류
  REJECTED // 반려 (허위/근거불충분)
  EXPLAINED // 해명됨
  DELETED // 삭제 (소프트 삭제)
}

enum IdentifierType {
  DISCORD_ID
  DISCORD_USERNAME
  DISCORD_SERVER
  DISCORD_INVITE
  PHONE
  BANK_ACCOUNT
  BANK_NAME
  ACCOUNT_HOLDER
  EMAIL
  TRADE_SITE
  GAME_NICK
  SELLER_NICK
  WEBSITE
  WALLET_ADDRESS
  PLATFORM_ID
  CASE_REF
}

enum EvidenceType {
  CHAT_CAPTURE
  TRANSFER_RECORD
  TRADE_SCREEN
  EMAIL
  DM
  VIDEO
  CONTRACT
  OTHER
}

enum DisputeReason {
  FACTUAL_ERROR
  WRONG_PERSON
  TRADE_COMPLETED
  ALREADY_REFUNDED
  WRONG_INFO
  DELETE_REQUEST
  OTHER
}

enum DisputeStatus {
  PENDING
  RESOLVED_KEEP
  RESOLVED_EDIT
  RESOLVED_HIDE
  RESOLVED_DELETE
  RESOLVED_NEED_MORE_INFO
}

enum AdminRole {
  OWNER
  ADMIN
  MODERATOR
  REVIEWER
  AUDITOR
}

// ─────────────────────────────────────────────────────────────
// 핵심 모델
// ─────────────────────────────────────────────────────────────

model Case {
  id            String     @id @default(cuid())
  caseNumber    String     @unique // 예: A10291
  status        CaseStatus @default(RECEIVED)
  damageType    String // 거래 미이행 / 입금 후 잠적 / 상품 미배송 등 (자유 문자열, 통계는 애플리케이션에서 집계)
  damageAmount  Int? // KRW, 알 수 없으면 null
  occurredAt    DateTime?
  description   String
  platform      String? // 관련 플랫폼 (Discord 등)
  isPublic      Boolean    @default(false) // 검증 전에는 공개 검색에 노출하지 않음
  visibility    String     @default("PENDING") // PENDING | PUBLIC | HIDDEN
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?
  deletedById   String?
  deleteReason  String?

  reports     Report[]
  identifiers CaseIdentifier[]
  evidence    Evidence[]
  disputes    Dispute[]
  timeline    CaseEvent[]

  @@index([status])
  @@index([isPublic])
}

model Report {
  id                String   @id @default(cuid())
  caseId            String
  case              Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reporterDiscordId String?
  reporterUsername  String?
  channelId         String?
  messageId         String? // 원본 제보 메시지 역추적용
  rawContent        String? // 원문 (자동 추출 대상 텍스트)
  autoExtracted     Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([caseId])
  @@index([reporterDiscordId])
}

model CaseIdentifier {
  id           String         @id @default(cuid())
  caseId       String
  case         Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type         IdentifierType
  value        String // 원본 값 (마스킹 전, 관리자만 조회)
  normalized   String // 검색용 정규화 값 (소문자/하이픈 제거 등)
  verified     Boolean        @default(false) // 운영진이 확인했는지
  source       String         @default("MANUAL") // MANUAL | AUTO_EXTRACT
  createdAt    DateTime       @default(now())

  @@index([type, normalized])
  @@index([caseId])
}

model Evidence {
  id          String       @id @default(cuid())
  caseId      String
  case        Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reportId    String?
  type        EvidenceType
  storagePath String // 로컬/오브젝트 스토리지 경로 (공개 URL 아님)
  fileHash    String
  fileName    String
  mimeType    String?
  sizeBytes   Int?
  uploadedBy  String? // discordId 또는 admin id
  uploadedAt  DateTime     @default(now())
  reviewed    Boolean      @default(false)
  deletedAt   DateTime?

  @@index([caseId])
}

model Dispute {
  id             String        @id @default(cuid())
  caseId         String
  case           Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  submitterId    String // discordId 또는 웹 세션 식별자
  reason         DisputeReason
  reasonDetail   String
  evidencePaths  String[]      @default([])
  status         DisputeStatus @default(PENDING)
  resolution     String?
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())

  @@index([caseId])
  @@index([status])
}

model CaseEvent {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  event     String // RECEIVED, AUTO_EXTRACTED, REVIEW_STARTED, STATUS_CHANGED, FIELD_EDITED, EVIDENCE_ADDED, DISPUTE_FILED, DISPUTE_RESOLVED, DELETED ...
  actorId   String? // discordId 또는 admin id, 시스템 이벤트는 null
  detail    Json?
  createdAt DateTime @default(now())

  @@index([caseId])
}

model AdminUser {
  id          String    @id @default(cuid())
  discordId   String    @unique
  displayName String?
  avatarHash  String?
  role        AdminRole @default(REVIEWER)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?

  auditLogs AuditLog[]
  sessions  AdminSession[]
}

model AdminSession {
  id        String   @id @default(cuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  ip        String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([adminId])
}

model AuditLog {
  id         String    @id @default(cuid())
  actorId    String? // AdminUser.id, 없으면 시스템
  admin      AdminUser? @relation(fields: [actorId], references: [id])
  action     String // CASE_VIEW, CASE_EDIT, CASE_APPROVE, CASE_REJECT, CASE_DELETE, DISPUTE_RESOLVE, EVIDENCE_DOWNLOAD, LOGIN, ...
  targetType String? // Case | Dispute | Evidence | AdminUser
  targetId   String?
  detail     Json?
  ipHash     String? // 원본 IP 대신 해시만 보관 (최소수집 원칙)
  createdAt  DateTime  @default(now())

  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model ReportRateLimit {
  id            String   @id @default(cuid())
  discordId     String
  windowStart   DateTime
  count         Int      @default(1)

  @@unique([discordId, windowStart])
}

model SearchLog {
  id        String   @id @default(cuid())
  source    String // DISCORD | WEB
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model DuplicateLink {
  id          String   @id @default(cuid())
  caseAId     String
  caseBId     String
  matchType   IdentifierType
  matchValue  String
  status      String   @default("PENDING") // PENDING | LINKED | REJECTED
  createdAt   DateTime @default(now())

  @@unique([caseAId, caseBId, matchType, matchValue])
}
