generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// 열거형은 Postgres enum으로 관리 (Prisma가 이관/검증 지원)
// ─────────────────────────────────────────────────────────────

enum CaseStatus {
  RECEIVED // 접수
  REVIEWING // 검토중
  NEEDS_MORE_INFO // 추가자료 요청
  VERIFIED // 검증완료
  DISPUTED // 이의제기
  ON_HOLD // 보류
  REJECTED // 반려 (허위/근거불충분)
  EXPLAINED // 해명됨
  DELETED // 삭제 (소프트 삭제)
}

enum IdentifierType {
  DISCORD_ID
  DISCORD_USERNAME
  DISCORD_SERVER
  DISCORD_INVITE
  PHONE
  BANK_ACCOUNT
  BANK_NAME
  ACCOUNT_HOLDER
  EMAIL
  TRADE_SITE
  GAME_NICK
  SELLER_NICK
  WEBSITE
  WALLET_ADDRESS
  PLATFORM_ID
  CASE_REF
}

enum EvidenceType {
  CHAT_CAPTURE
  TRANSFER_RECORD
  TRADE_SCREEN
  EMAIL
  DM
  VIDEO
  CONTRACT
  OTHER
}

enum DisputeReason {
  FACTUAL_ERROR
  WRONG_PERSON
  TRADE_COMPLETED
  ALREADY_REFUNDED
  WRONG_INFO
  DELETE_REQUEST
  OTHER
}

enum DisputeStatus {
  PENDING
  RESOLVED_KEEP
  RESOLVED_EDIT
  RESOLVED_HIDE
  RESOLVED_DELETE
  RESOLVED_NEED_MORE_INFO
}

enum AdminRole {
  OWNER
  ADMIN
  MODERATOR
  REVIEWER
  AUDITOR
}

enum CertStatus {
  PENDING // 인증 대기 (봇 설치 확인 전)
  INFO_CHECK // 서버 기본 정보 확인 중
  TESTING // 비공개 안전거래 테스트 진행 중
  REVIEW // 결과 검토 중 (재검토 포함)
  ACTIVE // 인증 완료
  EXPIRED // 인증 만료
  REVOKED // 인증 취소
  SUSPENDED // 인증 정지
}

enum CertTestType {
  BOT_INSTALLED // 인증 봇 설치 확인 (자동)
  ORDER_PROCESSING // 주문 처리
  PAYMENT_PROCESSING // 결제 처리
  PRODUCT_DELIVERY // 상품/서비스 제공
  TRADE_COMPLIANCE // 거래 약속 준수
  INQUIRY_RESPONSE // 문의 응답
  REFUND_POLICY // 환불 정책
  POST_SALE_SUPPORT // 거래 후 대응
  TERMS_POLICY // 약관/운영정책 확인
}

enum CertTestResult {
  NA // 미실시
  PASS
  FAIL
}

// ─────────────────────────────────────────────────────────────
// 핵심 모델
// ─────────────────────────────────────────────────────────────

model Case {
  id            String     @id @default(cuid())
  caseNumber    String     @unique // 예: A10291
  status        CaseStatus @default(RECEIVED)
  damageType    String // 거래 미이행 / 입금 후 잠적 / 상품 미배송 등 (자유 문자열, 통계는 애플리케이션에서 집계)
  damageAmount  Int? // KRW, 알 수 없으면 null
  occurredAt    DateTime?
  description   String
  platform      String? // 관련 플랫폼 (Discord 등)
  isPublic      Boolean    @default(false) // 검증 전에는 공개 검색에 노출하지 않음
  visibility    String     @default("PENDING") // PENDING | PUBLIC | HIDDEN
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?
  deletedById   String?
  deleteReason  String?
  evidenceThreadId String? @unique // 증거 제출 스레드 ID — 봇 재시작에도 살아남도록 DB에 저장 (인메모리 컬렉터 대신 messageCreate에서 조회)

  reports     Report[]
  identifiers CaseIdentifier[]
  evidence    Evidence[]
  disputes    Dispute[]
  timeline    CaseEvent[]

  @@index([status])
  @@index([isPublic])
}

model Report {
  id                String   @id @default(cuid())
  caseId            String
  case              Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reporterDiscordId String?
  reporterUsername  String?
  channelId         String?
  messageId         String? // 원본 제보 메시지 역추적용
  rawContent        String? // 원문 (자동 추출 대상 텍스트)
  autoExtracted     Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([caseId])
  @@index([reporterDiscordId])
}

model CaseIdentifier {
  id           String         @id @default(cuid())
  caseId       String
  case         Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type         IdentifierType
  value        String // 원본 값 (마스킹 전, 관리자만 조회)
  normalized   String // 검색용 정규화 값 (소문자/하이픈 제거 등)
  verified     Boolean        @default(false) // 운영진이 확인했는지
  source       String         @default("MANUAL") // MANUAL | AUTO_EXTRACT
  createdAt    DateTime       @default(now())

  @@index([type, normalized])
  @@index([caseId])
}

model Evidence {
  id          String       @id @default(cuid())
  caseId      String
  case        Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reportId    String?
  disputeId   String? // 이의제기 과정에서 제출된 증거면 설정 (제보 증거와 구분)
  dispute     Dispute?     @relation(fields: [disputeId], references: [id], onDelete: SetNull)
  type        EvidenceType
  storagePath String // 로컬/오브젝트 스토리지 경로 (공개 URL 아님)
  fileHash    String
  fileName    String
  mimeType    String?
  sizeBytes   Int?
  uploadedBy  String? // discordId 또는 admin id
  uploadedAt  DateTime     @default(now())
  reviewed    Boolean      @default(false)
  deletedAt   DateTime?

  @@index([caseId])
  @@index([disputeId])
}

model Dispute {
  id               String        @id @default(cuid())
  caseId           String
  case             Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  submitterId      String // discordId 또는 웹 세션 식별자
  reason           DisputeReason
  reasonDetail     String
  evidencePaths    String[]      @default([])
  evidenceThreadId String?       @unique // 이의제기 증거 제출 스레드 (Case와 동일한 방식 - DB에 저장해 봇 재시작에도 유지)
  status           DisputeStatus @default(PENDING)
  resolution       String?
  resolvedById     String?
  resolvedAt       DateTime?
  createdAt        DateTime      @default(now())

  evidence Evidence[]

  @@index([caseId])
  @@index([status])
}

model CaseEvent {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  event     String // RECEIVED, AUTO_EXTRACTED, REVIEW_STARTED, STATUS_CHANGED, FIELD_EDITED, EVIDENCE_ADDED, DISPUTE_FILED, DISPUTE_RESOLVED, DELETED ...
  actorId   String? // discordId 또는 admin id, 시스템 이벤트는 null
  detail    Json?
  createdAt DateTime @default(now())

  @@index([caseId])
}

model AdminUser {
  id          String    @id @default(cuid())
  discordId   String    @unique
  displayName String?
  avatarHash  String?
  role        AdminRole @default(REVIEWER)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?

  auditLogs AuditLog[]
  sessions  AdminSession[]
}

model AdminSession {
  id        String   @id @default(cuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  ip        String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([adminId])
}

model AuditLog {
  id         String    @id @default(cuid())
  actorId    String? // AdminUser.id, 없으면 시스템
  admin      AdminUser? @relation(fields: [actorId], references: [id])
  action     String // CASE_VIEW, CASE_EDIT, CASE_APPROVE, CASE_REJECT, CASE_DELETE, DISPUTE_RESOLVE, EVIDENCE_DOWNLOAD, LOGIN, ...
  targetType String? // Case | Dispute | Evidence | AdminUser
  targetId   String?
  detail     Json?
  ipHash     String? // 원본 IP 대신 해시만 보관 (최소수집 원칙)
  createdAt  DateTime  @default(now())

  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model ReportRateLimit {
  id            String   @id @default(cuid())
  discordId     String
  windowStart   DateTime
  count         Int      @default(1)

  @@unique([discordId, windowStart])
}

model SearchLog {
  id        String   @id @default(cuid())
  source    String // DISCORD | WEB
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model DuplicateLink {
  id          String   @id @default(cuid())
  caseAId     String
  caseBId     String
  matchType   IdentifierType
  matchValue  String
  status      String   @default("PENDING") // PENDING | LINKED | REJECTED
  createdAt   DateTime @default(now())

  @@unique([caseAId, caseBId, matchType, matchValue])
}

// ─────────────────────────────────────────────────────────────
// 안전서버 인증 (Safe Server Certification)
// ─────────────────────────────────────────────────────────────

model ServerCertification {
  id               String     @id @default(cuid())
  certNumber       String     @unique // 예: SV-19382
  guildId          String     @unique
  guildName        String?
  applicantId      String // 신청한 디스코드 사용자 ID
  status           CertStatus @default(PENDING)
  certPeriodDays   Int        @default(30)
  autoCheckResult  Json? // 봇 권한/채널 존재 여부 등 자동 확인 결과
  appliedAt        DateTime   @default(now())
  verifiedAt       DateTime?
  expiresAt        DateTime?
  lastVerifiedAt   DateTime?
  expiryNotifiedAt DateTime?
  revokedReason    String?
  notes            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  testItems CertTestItem[]
  events    CertEvent[]

  @@index([status])
  @@index([expiresAt])
}

model CertTestItem {
  id           String              @id @default(cuid())
  certId       String
  cert         ServerCertification @relation(fields: [certId], references: [id], onDelete: Cascade)
  testType     CertTestType
  result       CertTestResult      @default(NA)
  auto         Boolean             @default(false) // 자동 확인 항목 여부
  note         String?
  testedById   String?
  testedAt     DateTime?
  createdAt    DateTime            @default(now())

  @@unique([certId, testType])
}

model CertEvent {
  id        String              @id @default(cuid())
  certId    String
  cert      ServerCertification @relation(fields: [certId], references: [id], onDelete: Cascade)
  event     String // APPLIED, INFO_CHECKED, TEST_PLAN_ROLLED, TEST_RECORDED, STATUS_CHANGED, RENEWED, EXPIRED, REVOKED
  actorId   String?
  detail    Json?
  createdAt DateTime            @default(now())

  @@index([certId])
}
